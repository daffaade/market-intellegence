# Server Configuration
PORT=8080
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/market_intel?sslmode=disable
CACHE_TTL_HOURS=24

# External Python Intelligence Engine (FastAPI)
PYTHON_ENGINE_URL=http://localhost:8000

# Sectors API
SECTORS_BASE_URL=https://api.sectors.app/v1
SECTORS_API_KEY=your_sectors_api_key_here
MOCK_SECTORS=true

# AI Provider Configuration ("gemini", "groq", or "mock")
AI_PROVIDER=mock
AI_MODEL=gemini-3.5-flash
AI_API_KEY=your_ai_api_key_here
