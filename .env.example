# =====================================================================
# Market Intelligence Platform - Root Environment Configuration Template
# Duplicate this file as `.env` and fill in your respective API keys.
# =====================================================================

# ---------------------------------------------------------------------
# Sectors API (Used by data_processing & ai_engine & backend)
# ---------------------------------------------------------------------
SECTORS_API_KEY=your_sectors_api_key_here
SECTORS_BASE_URL=https://api.sectors.app/v1
MOCK_SECTORS=false

# ---------------------------------------------------------------------
# AI Engine Service (Python FastAPI, default port 8000)
# ---------------------------------------------------------------------
PYTHON_ENGINE_PORT=8000
PYTHON_ENGINE_URL=http://localhost:8000

# ---------------------------------------------------------------------
# AI Provider Configuration (for LLM Insights & Analysis)
# Provider options: "gemini", "groq", or "mock"
# ---------------------------------------------------------------------
AI_PROVIDER=mock
AI_MODEL=gemini-3.5-flash
AI_API_KEY=your_gemini_or_groq_api_key_here

# ---------------------------------------------------------------------
# Go Backend API Service (default port 8080)
# ---------------------------------------------------------------------
PORT=8080
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# When PostgreSQL is not available, Go backend auto-falls back to In-Memory mode
DATABASE_URL=postgres://postgres:postgres@localhost:5432/market_intel?sslmode=disable
CACHE_TTL_HOURS=24
